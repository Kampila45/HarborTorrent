{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the HarborTorrent desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "HarborTorrent.Api",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "HarborTorrent.Api",
          "sidecar": true
        }
    },
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": ["**/*.torrent"]
    },
    "notification:default",
    "process:default",
    "updater:default"
  ]
}
